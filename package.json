{
  "name": "kratos",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check",
    "lint:fix": "biome check --fix --formatter-enabled=true",
    "registry:build": "turbo run registry:build"
  },
  "knip": {
    "ignoreWorkspaces": [
      "packages/orion"
    ],
    "workspaces": {
      "packages/orion": {
        "entry": [
          "registry.json"
        ]
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=11.0.1"
    }
  }
}
