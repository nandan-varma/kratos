{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "registry:build": {
      "outputs": ["../../apps/docs/public/r/**"]
    },
    "build": {
      "dependsOn": ["^build", "registry:build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["registry:build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
