  "items": [
    {
      "name": "orion-theme",
      "type": "registry:theme",
      "title": "Orion Theme",
      "description": "Color palette, fonts, radius and shadow tokens shared by every Orion component.",
      "files": [],
      "css": {
        "@keyframes pixel-on": {
          "0%, 100%": {
            "opacity": "0.15"
          },
          "18%, 42%": {
            "opacity": "1"
          },
          "62%": {
            "opacity": "0.15"
          }
        },
        "@keyframes shimmer-text": {
          "0%": {
            "background-position": "150% center"
          },
          "100%": {
            "background-position": "-50% center"
          }
        },
        "@keyframes fade-in": {
          "0%": {
            "opacity": "0"
          },
          "100%": {
            "opacity": "1"
          }
        },
        "@keyframes fade-up": {
          "0%": {
            "opacity": "0",
            "transform": "translateY(8px)"
          },
          "100%": {
            "opacity": "1",
            "transform": "translateY(0px)"
          }
        },
        "@keyframes spin": {
          "100%": {
            "transform": "rotate(1turn)"
          }
        },
        "@keyframes stream-in": {
          "0%": {
            "opacity": "0",
            "filter": "blur(4px)"
          },
          "100%": {
            "opacity": "1",
            "filter": "blur(0px)"
          }
        },
        "@keyframes pop-in": {
          "0%": {
            "opacity": "0",
            "transform": "scale(0.95)"
          },
          "100%": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        },
        "@keyframes eq-bounce": {
          "0%, 100%": {
            "transform": "scaleY(0.35)"
          },
          "50%": {
            "transform": "scaleY(1)"
          }
        },
        "@layer components": {
          ".animated-underline": {
            "display": "inline-block",
            "position": "relative"
          },
          ".animated-underline::after": {
            "content": "\"\"",
            "position": "absolute",
            "left": "0px",
            "right": "0px",
            "bottom": "-1px",
            "height": "1px",
            "background": "currentcolor",
            "transform-origin": "0px center",
            "transform": "scaleX(0)",
            "transition": "transform .28s var(--ease-link)"
          },
          "a:hover .animated-underline::after, a:focus-visible .animated-underline::after": {
            "transform": "scaleX(1)"
          },
          ".primitive-card-pad": {
            "padding": "12px 16px"
          },
          ".primitive-card-bar,.primitive-card-footer": {
            "padding": "8px 16px"
          },
          ".primitive-table-cell": {
            "padding": "12px 16px !important"
          },
          ".primitive-icon-button": {
            "width": "28px",
            "height": "28px",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "border-radius": "var(--radius-control, 8px)"
          }
        }
      },
      "cssVars": {
        "theme": {
          "font-sans": "var(--font-inter), ui-sans-serif, system-ui, sans-serif",
